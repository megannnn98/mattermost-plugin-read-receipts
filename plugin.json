{
    "id": "com.integrasources.read-receipts",
    "name": "Read Receipts",
    "description": "Shows read receipts in direct, group, private and open Mattermost Desktop channels.",
    "version": "0.2.0",
    "homepage_url": "https://github.com/megannnn98/mattermost-plugin-read-receipts",
    "support_url": "https://github.com/megannnn98/mattermost-plugin-read-receipts/issues",
    "icon_path": "assets/icon.svg",
    "min_server_version": "9.5.0",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "Read Receipts plugin settings",
        "footer": "",
        "settings": [
            {
                "key": "EnableDebugLogging",
                "display_name": "Enable debug logging",
                "type": "bool",
                "help_text": "When true, plugin logs debug events (post IDs, user IDs only — never message text).",
                "default": false
            },
            {
                "key": "ReceiptRetentionDays",
                "display_name": "Receipt retention (days)",
                "type": "number",
                "help_text": "How many days per-post read timestamps are stored (1…3650; values ≤ 0 fall back to 30). After expiry only the watermark (fact of reading) remains with approximate time.",
                "default": 30,
                "placeholder": "30"
            },
            {
                "key": "EnabledChannelTypes",
                "display_name": "Enabled channel types",
                "type": "text",
                "help_text": "Channel types to collect read receipts in: D (direct), G (group), P (private), O (open). The default is D only — enabling G, P or O starts collecting read receipts for everyone in those channels, so it is an explicit decision. Invalid characters are ignored; an empty value falls back to D.",
                "default": "D",
                "placeholder": "D"
            }
        ]
    }
}
